    validation_split=0.2,
    epochs=200,
    batch_size=256,
    shuffle=True,
    callbacks=[early_stop, reduce_lr],
    verbose=1
)
import numpy as np

n_samples = 100

predictions = []

for i in range(n_samples):
    pred = model(X_test, training=True).numpy().flatten()
    predictions.append(pred)

predictions = np.array(predictions)

