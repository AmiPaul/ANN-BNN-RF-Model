
import os
import random
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

import tensorflow as tf
import tensorflow_probability as tfp

from tensorflow.keras import layers

from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

import joblib

tfd = tfp.distributions
tfpl = tfp.layers

SEED = 42

os.environ["PYTHONHASHSEED"] = str(SEED)

random.seed(SEED)
np.random.seed(SEED)
tf.random.set_seed(SEED)


# ============================================================
# 1. LOAD DATA
# ============================================================

mode_1_2 = np.loadtxt(
    'alldata_1-2_inter.txt',
    delimiter='\t',
    usecols=0
)

mode_3_4 = np.loadtxt(
    'alldata_3_4_inter.txt',
    delimiter='\t',
    usecols=0
)

mode_5_6 = np.loadtxt(
    'alldata_5_6_inter.txt',
    delimiter='\t',
    usecols=0
)

all_range_inter = np.loadtxt(
    'all-inter.txt',
    delimiter='\t',
    usecols=0
)


# ============================================================
# 2. CREATE AND SCALE THE DATA
# ============================================================

X = np.column_stack([
    mode_1_2,
    mode_3_4,
    mode_5_6
])

y = all_range_inter

print("X shape:", X.shape)
print("y shape:", y.shape)

assert X.shape[1] == 3
assert X.shape[0] == y.shape[0]

x_scaler = StandardScaler()
X_scaled = x_scaler.fit_transform(X)

y_scaler = StandardScaler()
y_scaled = y_scaler.fit_transform(
    y.reshape(-1, 1)
)

joblib.dump(x_scaler, "x_scaler.pkl")
joblib.dump(y_scaler, "y_scaler.pkl")


# ============================================================
# 3. RANDOM FOREST BASELINE
# ============================================================

rf_model = RandomForestRegressor(
    n_estimators=2000,
    max_depth=None,
    min_samples_leaf=1,
    max_features='sqrt',
    min_samples_split=2,
    random_state=SEED,
    n_jobs=-1
)

rf_model.fit(X_scaled, y)

rf_prediction = rf_model.predict(X_scaled)


rf_model = RandomForestRegressor(

    n_estimators=500,
    max_depth=20,
    min_samples_leaf=2,

    random_state=SEED,
    n_jobs=-1

)

rf_model.fit(
    X_scaled,
    y
)

rf_prediction = rf_model.predict(
    X_scaled
)


# Random Forest evaluation

rf_mae = mean_absolute_error(
    y,
    rf_prediction
)

rf_rmse = np.sqrt(
    mean_squared_error(
        y,
        rf_prediction
    )
)

rf_r2 = r2_score(
    y,
    rf_prediction
)

print("="*50)
print("Random Forest Performance")
print("="*50)

print(f"MAE  : {rf_mae:.4f}")
print(f"RMSE : {rf_rmse:.4f}")
print(f"R²   : {rf_r2:.6f}")

rf_prediction.shape


# ============================================================
# 4. BAYESIAN NEURAL NETWORK
# ============================================================

def prior(kernel_size, bias_size=0, dtype=None):

    n = kernel_size + bias_size

    prior_model = tf.keras.Sequential([

        tfpl.DistributionLambda(
            lambda t: tfd.MultivariateNormalDiag(
                loc=tf.zeros(n),
                scale_diag=tf.ones(n)
            )
        )

    ])

    return prior_model


def posterior(kernel_size, bias_size=0, dtype=None):

    n = kernel_size + bias_size

    posterior_model = tf.keras.Sequential([

        tfpl.VariableLayer(
            tfpl.MultivariateNormalTriL.params_size(n),
            dtype=dtype
        ),

        tfpl.MultivariateNormalTriL(n)

    ])

    return posterior_model


# BNN architecture

model = tf.keras.Sequential([

    layers.Input(shape=(3,)),

    layers.Dense(
        6,
        activation="relu"
    ),

    layers.BatchNormalization(),

    layers.Dropout(0.10),

    layers.Dense(
        6,
        activation="relu"
    ),

    layers.Dense(
        3,
        activation="relu"
    ),

    tfpl.DenseVariational(
        units=1,
        make_prior_fn=prior,
        make_posterior_fn=posterior,
        kl_weight=1/X_scaled.shape[0]
    )

])


# Compile BNN

model.compile(

    optimizer=tf.keras.optimizers.Adam(
        learning_rate=3e-4
    ),

    loss=tf.keras.losses.Huber(),

    metrics=[
        tf.keras.metrics.MeanAbsoluteError(
            name="mae"
        ),

        tf.keras.metrics.RootMeanSquaredError(
            name="rmse"
        )
    ]

)


# Early stopping

early_stop = tf.keras.callbacks.EarlyStopping(

    monitor="loss",

    patience=50,

    restore_best_weights=True,

    verbose=1

)


# Train BNN

history = model.fit(

    X_scaled,

    y_scaled,

    epochs=1000,

    batch_size=32,

    callbacks=[early_stop],

    verbose=1

)


# ============================================================
# 5. MONTE CARLO UNCERTAINTY ESTIMATION
# ============================================================

mc_samples = 200

predictions = np.zeros(
    (mc_samples, X_scaled.shape[0])
)

for i in range(mc_samples):

    predictions[i] = model(

        X_scaled,

        training=True

    ).numpy().flatten()


mean_prediction_scaled = predictions.mean(
    axis=0
)

uncertainty_scaled = predictions.std(
    axis=0
)


# Inverse scaling

mean_prediction = y_scaler.inverse_transform(

    mean_prediction_scaled.reshape(-1, 1)

).flatten()


uncertainty = (

    uncertainty_scaled

    * y_scaler.scale_[0]

)


# ============================================================
# 6. BNN PERFORMANCE EVALUATION
# ============================================================

bnn_mae = mean_absolute_error(

    y,

    mean_prediction

)

bnn_rmse = np.sqrt(

    mean_squared_error(

        y,

        mean_prediction

    )

)

bnn_r2 = r2_score(

    y,

    mean_prediction

)


print("="*50)
print("Bayesian Neural Network Performance")
print("="*50)

print(f"MAE  : {bnn_mae:.4f}")
print(f"RMSE : {bnn_rmse:.4f}")
print(f"R²   : {bnn_r2:.6f}")


print("="*50)
print("Bayesian Uncertainty")
print("="*50)

print(f"Mean Uncertainty : {uncertainty.mean():.4f}")
print(f"Min Uncertainty  : {uncertainty.min():.4f}")
print(f"Max Uncertainty  : {uncertainty.max():.4f}")


# ============================================================
# 7. CONFIDENCE-BASED HYBRID MODEL
# ============================================================

alpha = 1.0

confidence_bnn = 1.0 / (

    1.0 + alpha * uncertainty

)

confidence_rf = np.ones_like(

    confidence_bnn

)


# Calculate weights

weight_bnn = (

    confidence_bnn /

    (confidence_bnn + confidence_rf)

)

weight_rf = (

    confidence_rf /

    (confidence_bnn + confidence_rf)

)


# Weight statistics

print("="*50)
print("Weight Statistics")
print("="*50)

print(
    f"BNN weight : min={weight_bnn.min():.4f}, "
    f"max={weight_bnn.max():.4f}, "
    f"mean={weight_bnn.mean():.4f}"
)

print(
    f"RF weight  : min={weight_rf.min():.4f}, "
    f"max={weight_rf.max():.4f}, "
    f"mean={weight_rf.mean():.4f}"
)


# ============================================================
# 8. HYBRID PREDICTION
# ============================================================

hybrid_prediction = (

    weight_bnn * mean_prediction

    +

    weight_rf * rf_prediction

)


# ============================================================
# 9. HYBRID MODEL PERFORMANCE
# ============================================================

hybrid_mae = mean_absolute_error(

    y,

    hybrid_prediction

)

hybrid_rmse = np.sqrt(

    mean_squared_error(

        y,

        hybrid_prediction

    )

)

hybrid_r2 = r2_score(

    y,

    hybrid_prediction

)


print("="*50)
print("Hybrid Model Performance")
print("="*50)

print(f"MAE  : {hybrid_mae:.4f}")
print(f"RMSE : {hybrid_rmse:.4f}")
print(f"R²   : {hybrid_r2:.6f}")


# ============================================================
# 10. MODEL PERFORMANCE COMPARISON
# ============================================================

comparison = pd.DataFrame({

    "Model":[

        "Random Forest",

        "Bayesian Neural Network",

        "Hybrid"

    ],

    "MAE":[

        rf_mae,

        bnn_mae,

        hybrid_mae

    ],

    "RMSE":[

        rf_rmse,

        bnn_rmse,

        hybrid_rmse

    ],

    "R²":[

        rf_r2,

        bnn_r2,

        hybrid_r2

    ]

})

comparison


# ============================================================
# 11. HYBRID MODEL PREDICTION PLOT
# ============================================================

plt.figure(figsize=(6,6))

plt.scatter(
    y,
    hybrid_prediction,
    alpha=0.7
)

plt.plot(

    [y.min(), y.max()],

    [y.min(), y.max()],

    'r--',

    lw=2

)

plt.xlabel("Actual")

plt.ylabel("Hybrid Prediction")

plt.title("Hybrid Model")

plt.grid(True)

plt.tight_layout()

plt.show()


# ============================================================
# 12. SHAP ANALYSIS
# ============================================================

import shap

print(shap.__version__)


feature_names = [

    "Mode 1-2",

    "Mode 3-4",

    "Mode 5-6"

]


# Background dataset

background = shap.sample(

    X_scaled,

    100,

    random_state=SEED

)


# ============================================================
# 13. HYBRID PREDICTION FUNCTION FOR SHAP
# ============================================================

def hybrid_predict(X_input):

    # -----------------------------
    # Random Forest Prediction
    # -----------------------------

    rf_pred = rf_model.predict(X_input)


    # -----------------------------
    # Bayesian Prediction
    # -----------------------------

    mc_samples = 100

    predictions = np.zeros(
        (mc_samples, X_input.shape[0])
    )

    np.random.seed(SEED)
    tf.random.set_seed(SEED)

    for i in range(mc_samples):

        predictions[i] = model(

            X_input,

            training=True

        ).numpy().flatten()


    mean_prediction_scaled = predictions.mean(axis=0)

    uncertainty_scaled = predictions.std(axis=0)


    mean_prediction = y_scaler.inverse_transform(

        mean_prediction_scaled.reshape(-1, 1)

    ).flatten()


    uncertainty = (

        uncertainty_scaled

        * y_scaler.scale_[0]

    )


    # -----------------------------
    # Confidence Weighting
    # -----------------------------

    alpha = 1.0

    confidence_bnn = 1.0 / (

        1.0 + alpha * uncertainty

    )

    confidence_rf = np.ones_like(

        confidence_bnn

    )


    weight_bnn = (

        confidence_bnn /

        (confidence_bnn + confidence_rf)

    )

    weight_rf = (

        confidence_rf /

        (confidence_bnn + confidence_rf)

    )


    # -----------------------------
    # Hybrid Prediction
    # -----------------------------

    hybrid_prediction = (

        weight_bnn * mean_prediction

        +

        weight_rf * rf_pred

    )

    return hybrid_prediction


# Test prediction

test_prediction = hybrid_predict(X_scaled)

print(test_prediction.shape)


# ============================================================
# 14. SHAP KERNEL EXPLAINER
# ============================================================

explainer = shap.KernelExplainer(

    hybrid_predict,

    background

)


X_test = X_scaled


shap_values = explainer.shap_values(

    X_test

)


# ============================================================
# 15. SHAP SUMMARY PLOT
# ============================================================

shap.summary_plot(

    shap_values,

    X_scaled,

    feature_names=feature_names

)


# ============================================================
# 16. SHAP BAR PLOT
# ============================================================

shap.summary_plot(

    shap_values,

    X_scaled,

    feature_names=feature_names,

    plot_type="bar"

)


# ============================================================
# 17. CALCULATE SHAP CONTRIBUTIONS
# ============================================================

importance = np.mean(

    np.abs(shap_values),

    axis=0

)


percentage = (

    importance /

    importance.sum()

) * 100


contribution = pd.DataFrame({

    "Mode": feature_names,

    "Mean |SHAP|": importance,

    "Contribution (%)": percentage

})


contribution = contribution.sort_values(

    by="Contribution (%)",

    ascending=False

)


print(contribution)


# ============================================================
# 18. SAVE SHAP CONTRIBUTIONS
# ============================================================

contribution.to_csv(

    "Hybrid_SHAP_Contribution.csv",

    index=False

)


# ============================================================
# 19. SHAP CONTRIBUTION BAR GRAPH
# ============================================================

plt.figure(figsize=(6,4))

plt.bar(

    contribution["Mode"],

    contribution["Contribution (%)"]

)

plt.ylabel("Contribution (%)")

plt.xlabel("Mode")

plt.title("Contribution of Intermolecular Modes")

plt.grid(axis="y", alpha=0.3)

