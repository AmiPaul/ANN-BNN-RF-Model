# =====================================================
# IMPORT LIBRARIES
# =====================================================
import pandas as pd
import numpy as np

train_df = pd.read_csv(
    r"training-data-set",
    low_memory=False
)

test_df = pd.read_csv(
    r"testing-data-set",
    low_memory=False
)

print(train_df.shape)
print(test_df.shape)
# =====================================================
# FEATURES AND TARGET
# =====================================================

X_train = train_df.drop(columns=["trajectory", "tdiss"])
y_train = train_df["tdiss"]

X_test = test_df.drop(columns=["trajectory", "tdiss"])
y_test = test_df["tdiss"]

print("X_train:", X_train.shape)
print("X_test :", X_test.shape)
from sklearn.ensemble import RandomForestRegressor

rf = RandomForestRegressor(

    n_estimators=50,

    max_depth=10,

    min_samples_leaf=2,

    random_state=42,

    n_jobs=-1

)

rf.fit(X_train, y_train)
rf_pred = rf.predict(X_test)

print(rf_pred.shape)
rf_frame_results = pd.DataFrame({
    "trajectory": test_df["trajectory"].values,
    "RF_Prediction": rf_pred
})

rf_trajectory = (
    rf_frame_results
    .groupby("trajectory", as_index=False)
    .agg(RF_Prediction=("RF_Prediction", "median"))
)

print(rf_trajectory.head())
from sklearn.preprocessing import StandardScaler

# ---------------------------------
# Scale input features
# ---------------------------------
x_scaler = StandardScaler()

X_train_ann = x_scaler.fit_transform(X_train)
X_test_ann = x_scaler.transform(X_test)

# ---------------------------------
# Scale target
# ---------------------------------
y_scaler = StandardScaler()

y_train_scaled = y_scaler.fit_transform(
    y_train.values.reshape(-1, 1)
).flatten()

y_test_scaled = y_scaler.transform(
    y_test.values.reshape(-1, 1)
).flatten()

print(X_train_ann.shape)
print(X_test_ann.shape)
print(y_train_scaled.shape)
print(y_test_scaled.shape)
import tensorflow as tf
import tensorflow_probability as tfp
import numpy as np

tfd = tfp.distributions
tfpl = tfp.layers

tf.keras.backend.clear_session()

np.random.seed(42)
tf.random.set_seed(42)
def prior_fn(kernel_size, bias_size=0, dtype=None):

    n = kernel_size + bias_size

    prior_model = tf.keras.Sequential([

        tfpl.DistributionLambda(

            lambda t: tfd.Independent(

                tfd.Normal(

                    loc=tf.zeros(n),

                    scale=1.0

                ),

                reinterpreted_batch_ndims=1

            )

        )

    ])

    return prior_model
def posterior_fn(kernel_size, bias_size=0, dtype=None):

    n = kernel_size + bias_size

    posterior_model = tf.keras.Sequential([

        tfpl.VariableLayer(

            tfpl.IndependentNormal.params_size(n),

            dtype=dtype

        ),

        tfpl.IndependentNormal(n)

    ])

    return posterior_model
model = tf.keras.Sequential([

    tf.keras.layers.Input(shape=(X_train_ann.shape[1],)),

    # Hidden Layer 1
    tf.keras.layers.Dense(512, activation="relu"),
    tf.keras.layers.BatchNormalization(),
    tf.keras.layers.Dropout(0.30),

    # Hidden Layer 2
    tf.keras.layers.Dense(256, activation="relu"),
    tf.keras.layers.BatchNormalization(),
    tf.keras.layers.Dropout(0.25),

    # Hidden Layer 3
    tf.keras.layers.Dense(128, activation="relu"),
    tf.keras.layers.BatchNormalization(),

    # Hidden Layer 4
    tf.keras.layers.Dense(64, activation="relu"),

    # Hidden Layer 5
    tf.keras.layers.Dense(32, activation="relu"),

    # Bayesian Output Layer
    tfpl.DenseVariational(
        units=1,
        make_prior_fn=prior_fn,
        make_posterior_fn=posterior_fn,
        kl_weight=1 / X_train_ann.shape[0]
    )

])

model.summary()
model.compile(

    optimizer=tf.keras.optimizers.Adam(
        learning_rate=3e-4
    ),

    loss=tf.keras.losses.Huber(),

    metrics=["mae"]

)
early_stop = tf.keras.callbacks.EarlyStopping(

    monitor="val_loss",

    patience=20,

    restore_best_weights=True,

    verbose=1

)

reduce_lr = tf.keras.callbacks.ReduceLROnPlateau(

    monitor="val_loss",

    factor=0.5,

    patience=8,

    min_lr=1e-6,

    verbose=1

)
history = model.fit(

    X_train_ann,

    y_train_scaled,

    validation_split=0.20,

    epochs=100,

    batch_size=1024,

    shuffle=True,

    callbacks=[early_stop, reduce_lr],

    verbose=1

)
N_SAMPLES = 200

predictions = []

for _ in range(N_SAMPLES):

    pred = model(
        X_test_ann,
        training=True
    ).numpy().flatten()

    predictions.append(pred)

predictions = np.array(predictions)

print(predictions.shape)
# Mean prediction (scaled)
mu_scaled = np.mean(predictions, axis=0)

# Bayesian uncertainty (scaled)
sigma_scaled = np.std(predictions, axis=0)
# Mean prediction
mu = y_scaler.inverse_transform(
    mu_scaled.reshape(-1,1)
).flatten()

# Uncertainty
sigma = sigma_scaled * y_scaler.scale_[0]

print(mu.shape)
print(sigma.shape)
# Import libraries
import pandas as pd
import numpy as np

# Create frame-level ANN results
ann_frame_results = pd.DataFrame({
    "trajectory": test_df["trajectory"].values,
    "ANN_Prediction": mu,
    "ANN_Uncertainty": sigma,
    "Actual_tdiss": test_df["tdiss"].values
})

print(ann_frame_results.head())

# Aggregate predictions at trajectory level
ann_trajectory = (
    ann_frame_results
    .groupby("trajectory", as_index=False)
    .agg(
        ANN_Prediction=("ANN_Prediction", "median"),
        ANN_Uncertainty=("ANN_Uncertainty", "mean"),
        Actual_tdiss=("Actual_tdiss", "first")
    )
)

print(ann_trajectory.head())
ann_trajectory = ann_frame_results.groupby("trajectory").agg(

    ANN_Prediction=("ANN_Prediction", "median"),

    ANN_Uncertainty=("ANN_Uncertainty", "mean"),

    Actual_tdiss=("Actual_tdiss", "first")

).reset_index()

print(ann_trajectory.head())
# ---------------------------------------
# Merge RF and ANN-BNN predictions
# ---------------------------------------

results = ann_trajectory.merge(

    rf_trajectory,

    on="trajectory",

    how="inner"

)

print(results.head())

print(results.shape)
import numpy as np
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

# =====================================================
# Hybrid ANN-BNN + Random Forest using Confidence Weight
# =====================================================

alpha = 1.0
threshold = 0.45

# ANN confidence
results["ANN_Confidence"] = 1.0 / (1.0 + alpha * results["ANN_Uncertainty"])

# RF confidence (constant)
results["RF_Confidence"] = 1.0

# Normalize weights
weight_sum = results["ANN_Confidence"] + results["RF_Confidence"]

results["ANN_Weight"] = results["ANN_Confidence"] / weight_sum
results["RF_Weight"] = results["RF_Confidence"] / weight_sum

# Hybrid prediction
results["Hybrid_Prediction"] = (
    results["ANN_Weight"] * results["ANN_Prediction"] +
    results["RF_Weight"] * results["RF_Prediction"]
)

# =====================================================
# Use RF prediction when ANN uncertainty is high
# =====================================================

results["Final_Prediction"] = np.where(
    results["ANN_Uncertainty"] > threshold,
    results["RF_Prediction"],
    results["Hybrid_Prediction"]
)

# Performance
mae = mean_absolute_error(
    results["Actual_tdiss"],
    results["Final_Prediction"]
)

rmse = np.sqrt(
    mean_squared_error(
        results["Actual_tdiss"],
        results["Final_Prediction"]
    )
)

r2 = r2_score(
    results["Actual_tdiss"],
    results["Final_Prediction"]
)

print("=" * 60)
print("Hybrid ANN-BNN + Random Forest with Threshold")
print("=" * 60)
print(f"Alpha     : {alpha:.2f}")
print(f"Threshold : {threshold:.2f}")
print(f"MAE        : {mae:.4f}")
print(f"RMSE       : {rmse:.4f}")
print(f"R²         : {r2:.4f}")

print("\nFirst Five Results")
print(results[[
    "trajectory",
    "Actual_tdiss",
    "ANN_Prediction",
    "RF_Prediction",
    "ANN_Uncertainty",
    "ANN_Weight",
    "RF_Weight",
    "Hybrid_Prediction",
    "Final_Prediction"
]].head())
# Save results
results.to_csv(
    "Hybrid_ANN_BNN_RF_threshold_0.45_DIFF_TEMP.csv",
    index=False
)

print("Results saved successfully.")
